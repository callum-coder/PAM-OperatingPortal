# Portal Supabase project (its OWN project)
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_SERVICE_ROLE_KEY=
PORTAL_SUPABASE_ANON_KEY=

# PAM customer project - READ-ONLY Postgres connection string, not the project API URL
PAM_DATABASE_URL_READONLY=

# Anthropic
ANTHROPIC_API_KEY=
MODEL_SYNTHESIS=claude-opus-4-8
MODEL_PARSING=claude-haiku-4-5

# Email
EMAIL_PROVIDER_KEY=
EMAIL_FROM=
EMAIL_TO=

# Cron
CRON_SECRET=

# HubSpot (Private App access token, e.g. pat-eu1-...)
HUBSPOT_ACCESS_TOKEN=

# Slack (Bot User OAuth token, xoxb-...) and the default channel id agents post to
