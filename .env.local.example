# Public base URL of the portal, used to build links in agent Slack messages
PORTAL_BASE_URL=

# Fly.io browser worker (GTM Phase 2)
BROWSER_WORKER_URL=
BROWSER_WORKER_SECRET=

# GA4 (GTM Phase 3)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
